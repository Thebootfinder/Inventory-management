# Copier en .env.local et remplir avec la config de votre projet Firebase
# (Console Firebase > Paramètres du projet > Vos applications > Config SDK).
# Sans ces valeurs, l'app tourne en « mode local » (données sur l'appareil uniquement).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
