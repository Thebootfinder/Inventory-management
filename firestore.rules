rules_version = '2';

// Seules les adresses listées ici peuvent lire et modifier l'inventaire.
// Remplacez par les comptes Google de la maison, puis publiez :
//   Console Firebase > Firestore > Règles  (ou `firebase deploy --only firestore:rules`)
service cloud.firestore {
  match /databases/{database}/documents {
    function isHousehold() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'votre.adresse@gmail.com'
        ];
    }

    match /items/{itemId} {
      allow read: if isHousehold();
      allow create, update: if isHousehold()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.target is number;
      allow delete: if isHousehold();
    }

    // Historique : on peut ajouter des lignes, jamais les modifier.
    match /movements/{movementId} {
      allow read: if isHousehold();
      allow create: if isHousehold()
        && request.resource.data.delta is number
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Liste de courses partagée (un seul document : shared/courses).
    match /shared/{docId} {
      allow read, write: if isHousehold();
    }
  }
}
